apiVersion: charts.helm.k8s.io/v1
kind: Xl
metadata:
  name: xl-release
  namespace: turbonomic
spec:
  servicenow:
    enabled: true
  websphere:
    enabled: true
  jvm:
    enabled: true
  actionscript:
    enabled: true
  xen:
    enabled: false
  mysql:
    enabled: true
  global:
    customImageNames: false
    repository: icr.io/cpopen/turbonomic
    storageClassName: {{ STORAGE_CLASS_LARGE_BLOCK }}
    storageSelector: false
    tag: {{ current_feature.turbo_version }}
    securityContext:
      fsGroup: {{ FS_GROUP }}
    turboLite:
      enabled: false
    productList: turbonomic


    # Concert Requirements
    productList: turbonomic
    telemetry:
      enabled: false
  # Concert Gateway Service
  solisgateway:
    enabled: false
  concert-gateway:
    enabled: false
    hubURL: {{ HUB_URL }}

  # UI Configuration (disabled - Concert provides the UI)
  ui:
    enabled: true

  # Properties Configuration
  properties:
    api:
      basePrefixUrl: /turbonomic
      headerAuthenticationEnabled: true
      requestHeaderSize: '20000'
      vendor_latest_version: false
      vendor_public_key_url: 'https://concert-gateway.turbonomic.svc.cluster.local/gw/auth/jwtcert'
      vendor_public_key_skip_ssl_verification: true
      vendor_request_jwt_cookie: ibm-platform-session
      vendor_request_jwt_token: X-Auth-Token
      vendor_service_user_role: User
      vendor_skip_instance_id_check: true
      vendor_supported_admin_role: Admin
      vendor_supported_advisor_role: Advisor
      vendor_supported_automator_role: Automator
      vendor_supported_deployer_role: Deployer
      vendor_supported_parker_automator_role: Parking Automator
      vendor_supported_parker_role: Parking Administrator
      vendor_supported_observer_role: Observer
      vendor_supported_siteadmin_role: ServiceAdmin,ServiceOwner,Site Administrator
      allowTargetManagementInIntegrationMode: true
    global:
      concertEnabled: true
      deploymentMode: SERVER
      oauth2:
        audience: CONCERT
      solisEnabled: false
  # Ingress Configuration
  nginxingress:
    enabled: true
  nginx:
    httpsRedirect: true
    nginxIsPrimaryIngress: false
    insecureHttpOnly: false
    concertHubUrl: {{ HUB_URL }}
  openshiftingress:
    enabled: true


  tomcat:
    enabled: true
  grafana:
    adminPassword: vmturbo
    enabled: true
    grafana.ini:
      database:
        password: vmturbo
        type: postgres
  properties:
    extractor:
      grafanaAdminPassword: vmturbo
  ibmcloud:
    enabled: true
  postgres:
    enabled: false
  timescaledb:
    enabled: true
  extractor:
    enabled: true
  reporting:
    enabled: true
  powervm:
    enabled: true
  netapp:
    enabled: true
  hyperflex:
    enabled: true
  ucs:
    enabled: true
  udt:
    enabled: true
  kafka:
    persistence:
      size: 30Gi
  mssql:
    enabled: true
  rsyslog:
    persistence:
      size: 30Gi
  nutanix:
    enabled: true
  weblogic:
    enabled: false
  prometheus:
    enabled: false
  hyperv:
    enabled: true
  vcenter:
    enabled: true
  hpe3par:
    enabled: true
  oneview:
    enabled: true
  vmax:
    enabled: true
  instana:
    enabled: true
  azure:
    enabled: true
  actionstream-kafka:
    enabled: false
  scaleio:
    enabled: false
  kubeturbo:
    enabled: true
  wmi:
    enabled: true
  newrelic:
    enabled: true
  gcp:
    enabled: true
  appdynamics:
    enabled: true
  vmm:
    enabled: true
  webhook:
    enabled: true
  jboss:
    enabled: true
  pure:
    enabled: true
  prometurbo:
    enabled: true
  ibmstorage-flashsystem:
    enabled: true
  horizon:
    enabled: true
  appinsights:
    enabled: true
  dynatrace:
    enabled: true
  aws:
    enabled: true
  db:
    persistence:
      size: 30Gi
  snmp:
    enabled: true
  oracle:
    enabled: true
  sustainability:
    enabled: true