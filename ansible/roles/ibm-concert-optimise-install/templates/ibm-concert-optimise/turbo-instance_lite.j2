apiVersion: charts.helm.k8s.io/v1
kind: Xl
metadata:
  name: xl-release
  namespace: ibm-concert-optimise
spec:
  nginx:
    nginxIsPrimaryIngress: false
    httpsRedirect: false
  nginxingress:
    enabled: true
  openshiftingress:
    enabled: true

  global:
    customImageNames: false
    repository: icr.io/cpopen/turbonomic
    storageClassName: {{ STORAGE_CLASS_LARGE_BLOCK }}
    storageSelector: false
    tag: {{ current_feature.concert_optimise_version }}
    securityContext:
      fsGroup: {{ FS_GROUP }}
    turboLite:
      enabled: true

  properties:
    extractor:
      grafanaAdminPassword: vmturbo
  rsyslog:
    persistence:
      size: 30Gi
  solisgateway:
    enabled: false
  instana:
    enabled: true
  kubeturbo:
    enabled: true
  ui:
    enabled: true
  mcp-turbo-api:
    enabled: true
  concert-turbo:
    enabled: true

