---
apiVersion: charts.helm.k8s.io/v1
kind: Xl
metadata:
  name: xl-release
  namespace: ibm-concert-optimise
spec:
  # This configuration file is used for production.
  # Default values copied from <project_dir>/helm-charts/xl/values.yaml

  # Default values for turbolite deployment.
  # This is a YAML-formatted file.
  # Declare variables to be passed into your templates.

  # Any changes run : kubectl apply -f charts_v1_turbolite_cr.yaml -n turbonomic

  # Global settings
  global:
    turboLite:
      enabled: true
    repository: icr.io/cpopen/turbonomic
    tag: 8.21.5
    enableExternalSecrets: true
    storageClassName: {{ STORAGE_CLASS_LARGE_BLOCK }}
    storageSelector: false
    tag: {{ current_feature.concert_optimise_version }}
    securityContext:
      fsGroup: {{ FS_GROUP }}

  # Most components are disabled by helper templates when turboLite.enabled is set to true.
  
  # Required: Enable Instana  for TurboLite
  instana:
    enabled: true
  concert-turbo:
    enabled: true
  clickhouse:
    enabled: false
  metrics-store:
    enabled: false
  onprem-cost:
    enabled: false

  # Only used in Red Hat OpenShift deployments - uncomment if needed
  nginx:
    nginxIsPrimaryIngress: false
    httpsRedirect: false
    httpPort: 9080
    httpsPort: 9443
  nginxingress:
    enabled: true
  openshiftingress:
    enabled: true
  mcp-turbo-api:
    enabled: true
