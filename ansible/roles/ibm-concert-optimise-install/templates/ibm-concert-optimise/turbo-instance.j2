apiVersion: charts.helm.k8s.io/v1
kind: Xl
metadata:
  name: xl-release
  namespace: ibm-concert-optimise
spec:
  nginx:
    nginxIsPrimaryIngress: false
    httpsRedirect: false
  nginxingress:
    enabled: true
  openshiftingress:
    enabled: true

  global:
    customImageNames: false
    repository: icr.io/cpopen/turbonomic
    storageClassName: {{ STORAGE_CLASS_LARGE_BLOCK }}
    storageSelector: false
    tag: {{ current_feature.concert_optimise_version }}
    securityContext:
      fsGroup: {{ FS_GROUP }}
    turboLite:
      enabled: false
    turboai:
      config:
        env.parameters:
          env_name: on-prem
          feedback.enabled.override: false
          flags.a2a_enabled.override: true
          mcp.api.host: mcp-turbo-api
          mcp.api.max_connection_retries: '3'
          mcp.api.port: '8000'
          mcp.api.timeout: '30.0'
          mcp.api.transport: streamable-http
        watsonx.host: '{{current_feature.watsonx_url  | default('https://us-south.ml.cloud.ibm.com')}}'
        watsonx.project_id: {{current_feature.watsonx_projectid  | default('00000000-0000-0000-0000-000000000000')}}

  properties:
    extractor:
      grafanaAdminPassword: vmturbo


  postgres:
    enabled: false
  powervm:
    enabled: true
  nutanix:
    enabled: true
  prometheus:
    enabled: false
  hyperv:
    enabled: true
  vcenter:
    enabled: true
  instana:
    enabled: true
  azure:
    enabled: true
  kubeturbo:
    enabled: true
  newrelic:
    enabled: true
  gcp:
    enabled: true
  dynatrace:
    enabled: true
  aws:
    enabled: true
  sustainability:
    enabled: true
  servicenow:
    enabled: true
  mssql:
    enabled: true

  grafana:
    adminPassword: vmturbo
    enabled: true
    grafana.ini:
      database:
        password: vmturbo
        type: postgres

  kafka:
    persistence:
      size: 30Gi

  rsyslog:
    persistence:
      size: 30Gi
  db:
    persistence:
      size: 30Gi