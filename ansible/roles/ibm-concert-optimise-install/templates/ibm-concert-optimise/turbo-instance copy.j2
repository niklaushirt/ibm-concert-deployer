apiVersion: charts.helm.k8s.io/v1
kind: Xl
metadata:
  name: xl-release
  namespace: ibm-concert-optimise
spec:
  enabled: true


  global:
    turboai:
      config:
        env.parameters:
          env_name: on-prem
          feedback.enabled.override: false
          flags.a2a_enabled.override: true
          flags.intent.action_execution_flow.override: true
          flags.intent_identification.override: true
          mcp.api.host: mcp-turbo-api
          mcp.api.max_connection_retries: "3"
          mcp.api.port: "8000"
          mcp.api.timeout: "30.0"
          mcp.api.transport: streamable-http
          watsonx.host: 'https://us-south.ml.cloud.ibm.com'
          watsonx.project_id: 00000000-0000-0000-0000-000000000000
        watsonx.host: '{{current_feature.watsonx_url  | default('https://us-south.ml.cloud.ibm.com')}}'
        watsonx.project_id: {{current_feature.watsonx_projectid  | default('00000000-0000-0000-0000-000000000000')}}
    storageClassName: {{ STORAGE_CLASS_LARGE_BLOCK }}
    repository: icr.io/cpopen/turbonomic
    turboLite:
      enabled: false
    productList: turbonomic
    securityContext:
      fsGroup: {{ FS_GROUP }}
    telemetry:
      enabled: false
    storageSelector: false
    tag: {{ current_feature.concert_optimise_version }}
    customImageNames: false
  
    properties:
    api:
      vendor_supported_parker_automator_role: Parking Automator
      vendor_request_jwt_cookie: ibm-platform-session
      vendor_skip_instance_id_check: true
      vendor_service_user_role: User
      vendor_supported_automator_role: Automator
      basePrefixUrl: /turbonomic
      vendor_supported_admin_role: Admin
      vendor_public_key_skip_ssl_verification: true
      vendor_public_key_url: 'https://concert-gateway.ibm-concert-optimise.svc.cluster.local/gw/auth/jwtcert'
      vendor_supported_siteadmin_role: 'ServiceAdmin,ServiceOwner,Site Administrator'
      allowTargetManagementInIntegrationMode: true
      vendor_supported_parker_role: Parking Administrator
      vendor_supported_observer_role: Observer
      vendor_latest_version: false
      vendor_supported_deployer_role: Deployer
      vendor_request_jwt_token: X-Auth-Token
      headerAuthenticationEnabled: true
      requestHeaderSize: '20000'
      vendor_supported_advisor_role: Advisor
    extractor:
      grafanaAdminPassword: vmturbo
    global:
      concertEnabled: true
      deploymentMode: SERVER
      oauth2:
        audience: CONCERT
      solisEnabled: false


  nginx:
    concertHubUrl: '{{ HUB_URL }}'
    httpsRedirect: true
    insecureHttpOnly: false
    nginxIsPrimaryIngress: false

  
    concert-gateway:
    enabled: true
    hubURL: {{ HUB_URL }}
    service:
      type: LoadBalancer
    ingress:
      enabled: true
      ingressClassName: nginx
      annotations:
        nginx.ingress.kubernetes.io/backend-protocol: "HTTPS"
        nginx.ingress.kubernetes.io/ssl-passthrough: "true"
        nginx.ingress.kubernetes.io/ssl-redirect: "true"
        nginx.ingress.kubernetes.io/proxy-connect-timeout: "300"
        nginx.ingress.kubernetes.io/proxy-send-timeout: "300"
        nginx.ingress.kubernetes.io/proxy-read-timeout: "300"
      hosts:
        - host: {{ PLATFORM_GW_HOST }}
          paths:
            - path: /
              pathType: Prefix
              port: 443
      tls:
        - secretName: nginx-ingressgateway-certs
          hosts:
            - {{ PLATFORM_GW_HOST }}

  
  
  tomcat:
    enabled: true
  grafana:
    adminPassword: vmturbo
    enabled: true
    grafana.ini:
      database:
        password: vmturbo
        type: postgres
  extractor:
    enabled: true
  netapp:
    enabled: true
  hyperflex:
    enabled: true
  ucs:
    enabled: true
  udt:
    enabled: true
  turboai:
    enabled: true
  kafka:
    persistence:
      size: 30Gi
  sustainability:
    enabled: true
  mssql:
    enabled: true
  rsyslog:
    persistence:
      size: 30Gi
  nutanix:
    enabled: true
  weblogic:
    enabled: false
  prometheus:
    enabled: false
  solisgateway:
    enabled: false
  hyperv:
    enabled: true
  vcenter:
    enabled: true
  hpe3par:
    enabled: true
  oneview:
    enabled: true
  vmax:
    enabled: true
  instana:
    enabled: true
  reporting:
    enabled: true
  azure:
    enabled: true
  actionstream-kafka:
    enabled: false
  scaleio:
    enabled: false
  kubeturbo:
    enabled: true
  wmi:
    enabled: true
  mysql:
    enabled: true
  servicenow:
    enabled: true
  websphere:
    enabled: true
  ibmcloud:
    enabled: true
  jvm:
    enabled: true
  actionscript:
    enabled: true
  xen:
    enabled: false

  newrelic:
    enabled: true
  ui:
    enabled: true
  gcp:
    enabled: true
  appdynamics:
    enabled: true
  vmm:
    enabled: true
  webhook:
    enabled: true
  jboss:
    enabled: true
  mcp-turbo-api:
    enabled: true
  pure:
    enabled: true
  prometurbo:
    enabled: true
  ibmstorage-flashsystem:
    enabled: true
  postgres:
    enabled: false
  horizon:
    enabled: true
  nginxingress:
    enabled: true
  timescaledb:
    enabled: true
  appinsights:
    enabled: true
  powervm:
    enabled: true
  dynatrace:
    enabled: true
  aws:
    enabled: true
  openshiftingress:
    enabled: true
  db:
    persistence:
      size: 30Gi
  snmp:
    enabled: true
  oracle:
    enabled: true
