# Source: robot-shop/templates/cart-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  namespace: robot-shop
  name: cart
  labels:
    service: cart
spec:
  replicas: 1
  selector:
    matchLabels:
      service: cart
  template:
    metadata:
      labels:
        service: cart
    spec:
      
      imagePullSecrets:
        - name: dockerhub-secret
      containers:
      - name: cart
        image: quay.io/niklaushirt/rs-cart:1.0
        imagePullPolicy: IfNotPresent
        # agent networking access
        env:
          - name: INSTANA_AGENT_HOST
            valueFrom:
              fieldRef:
                fieldPath: status.hostIP
        ports:
        - containerPort: 8080
        resources:
          limits:
            cpu: 200m
            memory: 100Mi
          requests:
            cpu: 100m
            memory: 50Mi

